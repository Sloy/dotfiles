[user]
	name = Rafa Vázquez
	email = rafa.vazsan@gmail.com

[includeIf "gitdir:~/ShadowMosses/work/"]
    path = ~/ShadowMosses/work/.gitconfig


[core]
	excludefile = ~/.gitignore
	excludesfile = ~/.gitignore_global
	editor = nano
	precomposeunicode = true
	autocrlf = input
	ignorecase = false
	# Make `git rebase` safer on macOS
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false

[color]
	ui = true

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = green
	changed = yellow
	untracked = cyan

[apply]
	# Detect whitespace errors when applying a patch
	whitespace = fix

[alias]
	## SHORT ALIASES
	#co = checkout # Disabled, so I'm forced to get used to "sw"
	sw = switch
	swd = switch --detach
	ci = commit
	cim = commit -m
	st = status
	br = branch
	cp = cherry-pick
	graph = log --graph --pretty=oneline --abbrev-commit
	tags = tag -l
	branches = branch -a
	remotes = remote -v

	## SIMPLE COMMANDS
	# Show local branches ordered by last commit date (thanks to https://twitter.com/viktorklang/status/1214898430964838400):
	brs = "for-each-ref --sort='authordate:iso8601' --format='%(color:green)%(refname:short)%09%(color:white)%(authordate:relative)' refs/heads"
	brf = "!git for-each-ref --sort='authordate:iso8601' --format='%(refname:short)%09%(color:green)%(authordate:relative)%(color:reset)' refs/heads | fzf --ansi --tac --no-sort --bind='enter:execute(echo {1} | pbcopy)+abort' --preview='git log --oneline --color=always -10 {1}' --preview-window=right:50%"
	# Destroys all tracked and untracked changes
	fire = "!f() { git reset --hard; git clean -f -d; }; f"
	# Amends last commit with the index skipping the message editting
	amend = commit --amend --no-edit
	# Commits current changes with a "WIP" message
	wip = commit -a -m "WIP" --no-verify
	# Soft resets last commit (reverses the command wip)
	unwip = reset --soft HEAD^
	# Forced push variant that checks for unknown changes in remote
	pushf = push --force-with-lease
	# Interactive rebase with the given number of latest commits
	ri = "!r() { git rebase -i HEAD~$1; }; r"
	rc = "rebase --continue"
	# List contributors with number of commits
	contributors = shortlog --summary --numbered
	# Find tags containing commit
	ft = "!f() { git describe --always --contains $1; }; f"

	## ADVANCED COMMANDS
	# Deletes local branches whose remote is gone, plus local-only branches already merged into HEAD (except master and develop). Skips branches checked out in a worktree
	bclean = "!git for-each-ref --format='%(refname:short)|%(upstream:track)|%(worktreepath)' refs/heads | while IFS='|' read -r branch track worktree; do if [ \"$track\" = '[gone]' ] && [ -z \"$worktree\" ]; then git branch -D \"$branch\"; fi; done; git for-each-ref --merged HEAD --format='%(refname:short)|%(upstream)|%(worktreepath)' refs/heads | while IFS='|' read -r branch upstream worktree; do if [ -z \"$upstream\" ] && [ -z \"$worktree\" ] && [ \"$branch\" != master ] && [ \"$branch\" != develop ]; then git branch -d \"$branch\"; fi; done"
	# Removes worktrees (and their branch) whose remote branch is gone. Skips dirty or locked worktrees and prints the force command
	wtclean = "!f() { main=$(git worktree list --porcelain | sed -n '1s/^worktree //p') && cd \"$main\" && unset GIT_DIR GIT_WORK_TREE; y=; d=; r=; if [ -t 2 ]; then y=$(printf '\\033[33m'); d=$(printf '\\033[90m'); r=$(printf '\\033[0m'); fi; git for-each-ref --format='%(refname:short)|%(upstream:track)|%(worktreepath)' refs/heads | while IFS='|' read -r branch track worktree; do [ \"$track\" = '[gone]' ] && [ -n \"$worktree\" ] && [ \"$worktree\" != \"$main\" ] || continue; echo \"Deleting ${worktree##*/}...\"; git worktree remove \"$worktree\" 2>/dev/null || { echo \"${y}Skipped ${worktree##*/} (uncommitted changes or locked)${r}\" >&2; echo \"${d}  git worktree remove --force '$worktree'${r}\" >&2; continue; }; echo \"Deleted ${worktree##*/}\"; git branch -D \"$branch\"; done; }; f"
	# Fetches and prunes, then deletes local branches and worktrees whose remote is gone
	roomba = "!git fetch -p && git bclean && git wtclean"
	# Pushes the current branch to a new remote branch in origin and track it
	pushr = "!f() { git rev-parse --abbrev-ref HEAD | xargs git push -u origin; }; f"
	# Pulls the master branch and leaves you in the current branch
	pullmaster = fetch origin master:master
	# Fetches origin/master and rebases the current branch on top of it (works when master is checked out in another worktree)
	rebmaster = "!f() { git fetch origin master && git rebase origin/master --autostash; }; f"
	# Interactive rebase from master to the current commit
	ribranch = "!r() { git rebase -i $(git merge-base master HEAD); }; r"
	# Squash the current branch into 1 commit since the first common ancestor of master
	squashbranch = "!r() { CUR=`git rev-parse HEAD`; git reset --soft $(git merge-base master HEAD); git commit -m \"$(git log --format=%B ${1}..${CUR})\"; }; r"
	# Amend an older commit. Usage: git fixup <commit-ref>. From https://blog.filippo.io/git-fixup-amending-an-older-commit/
	fixup = "!f() { TARGET=$(git rev-parse "$1"); git commit --fixup=$TARGET ${@:2} && EDITOR=true git rebase -i --autostash --autosquash $TARGET^; }; f"
	# Prints the body of all commits since last tag (PR title when used with GitHub merge&squash)
	changelog = "!f() { git describe --abbrev=0 --tags | xargs -I {} git log {}..HEAD --format=%s; }; f"
	# Push tags and master after preparing a release
	release = "!f() { git push --tags && git push origin master; }; f"
	# Discard the local branch and reset it to the remote tracked one. Useful for updating rebased branches.
	fenix = "!f() { git for-each-ref --format='%(upstream:short)' $(git symbolic-ref -q HEAD) | xargs -I {} git reset --hard {}; }; f"
	pr = "!f() { git pushr && ~/dotfiles/git/github-pull-request.sh; }; f"

[push]
	default = simple
[pull]
	ff = only
[diff]
	indentHeuristic = on
	compactionHeuristic = on
[pager]
	branch = false
	# https://github.com/so-fancy/diff-so-fancy
	diff = diff-so-fancy | less --tabs=4 -RFX
	show = diff-so-fancy | less --tabs=4 -RFX
[credential]
	helper = osxkeychain
[url "git@github.com:"]
	insteadOf = https://github.com/
[rerere]
	enabled = true
